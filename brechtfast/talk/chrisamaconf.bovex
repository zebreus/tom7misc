(*   -*- electric-indent-local-mode: nil -*- *)
let
  import "stdlib.bovex"
  import "layout.bovex"
  import "font.bovex"
  import "cite.bovex"
  import "color.bovex"

  import "talk-shared.bovex"

  do set-doc-info { (TalkInfo)
                    width = pixel 1920.0,
                    height = pixel 1080.0 }

  (* do REPHRASE-ALL := SOME 50 *)
  do REPHRASE-ALL := NONE
  do NO-REPHRASE := true

  val slide = slide with BACKGROUND = "mushroombg.png"

  fun just-crisp-image filename =
    let
      val img = image-scale-to { image = image-load filename,
                                 width = SLIDE-WIDTH,
                                 height = SLIDE-HEIGHT,
                                 scaling = NEAREST-NEIGHBOR }
    in
      output-frame
      (!current-page, !current-frame,
       image-sticker { img = img, x = 0.0, y = 0.0, width = SLIDE-WIDTH });

      next-slide()
    end


  fun bullet-reveal slide title bullets =
    let
      val n = list-length bullets
    in
      for 0 n
      (fn len =>
       combo-slide slide
       (Title title ::
        Bullets (list-take len bullets) ::
        nil))
    end

  fun gradient-string ramp s =
    let
      val len = string-length s
    in
      layout-concat
      (list-tabulate
       (len,
        (fn i =>
         let
           val t = int-to-float i /. int-to-float len
           val c = codepoint-to-string (string-sub (s, i))
           val rgba = color-linear-gradient (ramp, t)
         in
           color rgba (layout c)
         end)))
    end

  fun conjecture-bullets bull =
    combo-slide (slide with BACKGROUND = "durer.jpg"
                 with CONTENT-START-Y = 540.0
                 with TITLE-FONT-SIZE = 104.0)
    (Title [Albrecht Dürer's Conjecture] ::
     Bullets bull ::
     nil)

in
  set-target-seconds (!current-page, 0);

  title-slide (slide with BACKGROUND = "registration-marks-bg.png")
  [Go to next slide] [ ] [ ];

  set-target-seconds (!current-page, 0);

  title-slide slide (color 0xFFFFFFFF [Brechtfast of champions])
  (color 0xc25e32ff [by Tom 7]) (gradient-string VISIBLE-SPECTRUM
                                 "CHRISAMACONF.STL");
  (* "nothing but net" *)

  combo-slide (slide with BACKGROUND = "3dprinting.jpg")
  (Title [.STL = Stereolithography] :: nil);


  combo-slide slide
  (Title [2D Printing] ::
   Bullets ([e.g. [color 0xFF00FFFF [.SVG]] files] ::
            [use this to mail polyhedra to your friends at
             discount flat-pack rates using the postal service] ::
            [100% legal] ::
            nil) ::
   nil);

  combo-slide slide
  (Title [2D Printing] ::
   Image { img = image-load-cache "dodecahedron-example.png",
           x = pixel 100.0,
           y = pixel 100.0,
           scale = ORIGINAL } ::
   nil);

  (* Here's a thing I like about nets. *)
  combo-slide slide
  (Title [Cool] ::
   Image { img = image-load-cache "parens.png",
           x = pixel 100.0,
           y = pixel 100.0,
           scale = ORIGINAL } ::
   nil);

  combo-slide (slide with BACKGROUND = "durer.jpg"
               with CONTENT-START-Y = 540.0
               with TITLE-FONT-SIZE = 104.0)
  (Title [Dead Albrecht Dürer (1471–1582)] ::
   Bullets ([One-trick pony] ::
            [Only cared about convex polyhedra] ::
            [[it (color 0xFFFFCCFF [Call of Duty: Black Ops 6])]
             “Prestige” level: [b (color 0xFF4444FF [Nothing. Zero Points. ] ^^
                                   color 0xFF0000FF [A failure.])]] ::
            nil) ::
   nil);


  attributed-quote-slide (slide with BACKGROUND = "durer.jpg"
                          with QUOTE-FONT-SIZE = 80.0
                          with CONTENT-WIDTH = 900.0)
  [Dürer’s Conjecture]
  [“Every convex polyhedron has a [color 0x99CCFFFF [net]].”]
  [Dead Albrecht Dürer];

  (* compiler bug *)

  monospace-slide (slide
                   with BACKGROUND = "mushroombg.png"
                   with MONOSPACE-FONT-SIZE = 64.0)
  [Compiler büg]
(color 0xAAAAAAFF [[color 0xFFFF99FF [Simplifying...]]
[color 0xEEEECCFF [il-typed-pass.h:527]]:[color 0xFF8888FF [Check failed]]:
tt->type == TypeType::RECORD
Bug? Expected record, but got: a$314
[color 0x777777FF [make: *** [layout "["]makefile:12: chrisamaconf/chrisamaconf.talk[layout "]"] Error 127]]]);

  (* hours later... *)

  (* When I'm feeling stressed out about the state of the world I
     like to find an old very hard math problem and try to solve
     it myself, without looking at any spoilers *)

  conjecture-bullets ([It is very easy to find nets!] :: nil);

  just-image "hard307298.png";

  (* Digging the hole from two sides... *)

  conjecture-bullets ([It is very easy to find nets!] ::
                      [¬¬A] ::
                      nil);

  combo-slide (slide with BACKGROUND = "cereal.png"
               with BODY-FONT-SIZE = 240.0)
  (TextBox { x = 80.0, y = 300.0,
             width = 1920.0 *. 0.5 -. 80.0,
             text = color 0x000000FF
             [Does \\
              [it [Brechtfast]] \\
              exist?] } ::
   nil);

  just-image "hard251196.png";

  (* The most definitive thing would be to find a counterexample, but
     maybe counterexamples don't exist!
     So I tried strengthening the conjecture... *)

                      [Maybe it’s so easy that there always
                       exists a net of a special form? Like
                       a line?] ::


  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (Image { img = image-load-cache "have-cube.png",
           x = 0.0, y = 0.0, scale = ORIGINAL } :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (Image { img = image-load-cache "remove-corners.png",
           x = 0.0, y = 0.0, scale = ORIGINAL } :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (Image { img = image-load-cache "cuboctahedron.png",
           x = 0.0, y = 0.0, scale = ORIGINAL } :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (Image { img = image-load-cache "cuboctahedron-parity.png",
           x = 0.0, y = 0.0, scale = ORIGINAL } :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (Image { img = image-load-cache "ohno.png",
           x = 0.0, y = 0.0, scale = ORIGINAL } :: nil);

(*

  (* just-video (slide with LOOP-VIDEO = true) "title-loop.mp4"; *)

  (* just-crisp-image "httpv.png"; *)

  bullet-reveal slide (size 100.0 [Who has the best random numbers?])
  ((size 200.0 [Banks]) :: nil);

  just-video slide "cc-rng.mp4";


  bullet-reveal slide [Toxic max-security begone!!]
   ([There is no real security problem here. They are just
     trying to [b (color 0xFF5555FF [shame me])] into compliance.] ::
    [Perhaps we need to counterbalance this with some ...
     VULNERABILITY‽ ] :: nil);

  set-target-seconds (!current-page, 8 * 60);

  centered-text-slide slide [ ];

*)

  ()

end
