(*   -*- electric-indent-local-mode: nil -*- *)
let
  import "stdlib.bovex"
  import "layout.bovex"
  import "font.bovex"
  import "cite.bovex"
  import "color.bovex"

  import "talk-shared.bovex"

  do set-doc-info { (TalkInfo)
                    width = pixel 1920.0,
                    height = pixel 1080.0 }

  (* do REPHRASE-ALL := SOME 50 *)
  do REPHRASE-ALL := NONE
  do NO-REPHRASE := true

  val slide = slide with BACKGROUND = "mushroombg.png"

  fun just-crisp-image filename =
    let
      val img = image-scale-to { image = image-load filename,
                                 width = SLIDE-WIDTH,
                                 height = SLIDE-HEIGHT,
                                 scaling = NEAREST-NEIGHBOR }
    in
      output-frame
      (!current-page, !current-frame,
       image-sticker { img = img, x = 0.0, y = 0.0, width = SLIDE-WIDTH });

      next-slide()
    end


  fun bullet-reveal slide title bullets =
    let
      val n = list-length bullets
    in
      for 0 n
      (fn len =>
       combo-slide slide
       (Title title ::
        Bullets (list-take len bullets) ::
        nil))
    end

  fun gradient-string ramp s =
    let
      val len = string-length s
    in
      layout-concat
      (list-tabulate
       (len,
        (fn i =>
         let
           val t = int-to-float i /. int-to-float len
           val c = codepoint-to-string (string-sub (s, i))
           val rgba = color-linear-gradient (ramp, t)
         in
           color rgba (layout c)
         end)))
    end

in
  set-target-seconds (!current-page, 0);

  title-slide (slide with BACKGROUND = "black.png") [Go to next slide] [ ] [ ];

  set-target-seconds (!current-page, 0);

  title-slide slide (color 0xFFFFFFFF [Brechtfast of champions])
  (color 0xc25e32ff [by Tom 7]) (gradient-string VISIBLE-SPECTRUM
                                 "CHRISAMACONF.STL");
  (* "nothing but net" *)

  combo-slide (slide with BACKGROUND = "3dprinting.jpg")
  (Title [.STL = Stereolithography] :: nil);


  combo-slide slide
  (Title [2D Printing] ::
   Bullets ([e.g. [color 0xFF00FFFF [.SVG]] files] ::
            [use this to mail polyhedra to your friends at
             discount flat-pack rates using the postal service] ::
            [100% legal] ::
            nil) ::
   nil);

  combo-slide slide
  (Title [2D Printing] ::
   Image { img = image-load-cache "dodecahedron-example.png",
           x = pixel 100.0,
           y = pixel 100.0,
           scale = ORIGINAL } ::
   nil);

  (* Here's a thing I like about nets. *)
  combo-slide slide
  (Title [Cool] ::
   Image { img = image-load-cache "parens.png",
           x = pixel 100.0,
           y = pixel 100.0,
           scale = ORIGINAL } ::
   nil);

  combo-slide (slide with BACKGROUND = "durer.jpg"
               with CONTENT-START-Y = 540.0
               with TITLE-FONT-SIZE = 104.0)
  (Title [Dead Albrecht Dürer (1471–1582)] ::
   Bullets ([One-trick pony] ::
            [Only cared about convex polyhedra] ::
            [[it (color 0xFFFFCCFF [Call of Duty: Black Ops 6])]
             “Prestige” level: [b (color 0xFF4444FF [Nothing. Zero Points. ] ^^
                                   color 0xFF0000FF [A failure.])]] ::
            nil) ::
   nil);


  attributed-quote-slide (slide with BACKGROUND = "durer.jpg"
                          with QUOTE-FONT-SIZE = 80.0
                          with CONTENT-WIDTH = 900.0)
  [Dürer’s Conjecture]
  [“Every convex polyhedron has a [color 0x99CCFFFF [net]].”]
  [Dead Albrecht Dürer];




