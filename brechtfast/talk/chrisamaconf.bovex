(*   -*- electric-indent-local-mode: nil -*- *)
let
  import "stdlib.bovex"
  import "layout.bovex"
  import "font.bovex"
  import "cite.bovex"
  import "color.bovex"

  import "talk-shared.bovex"

  do set-doc-info { (TalkInfo)
                    width = pixel 1920.0,
                    height = pixel 1080.0 }

  (* do REPHRASE-ALL := SOME 50 *)
  do REPHRASE-ALL := NONE
  do NO-REPHRASE := true

  val slide = slide
    with BACKGROUND = "mushroombg.png"

  fun just-crisp-image filename =
    let
      val img = image-scale-to { image = image-load filename,
                                 width = SLIDE-WIDTH,
                                 height = SLIDE-HEIGHT,
                                 scaling = NEAREST-NEIGHBOR }
    in
      output-frame
      (!current-page, !current-frame,
       image-sticker { img = img, x = 0.0, y = 0.0, width = SLIDE-WIDTH });

      next-slide()
    end

  (* Creates n slides with each non-empty prefix of the stages,
     like combo-slide would. *)
  fun reveal slide (stages : element list list) =
    let
      val n = list-length stages
    in
      (* Include the first stage always. *)
      for 1 n
      (fn len =>
       combo-slide slide
       (list-concat (list-take len stages)))
    end

  fun image-overlay-elt filename =
    Image { img = image-load-cache filename,
            x = 0.0,
            y = 0.0,
            scale = ORIGINAL }

  fun bullet-reveal slide title bullets =
    reveal slide (list-map (fn e => e :: nil)
                  (Title title ::
                   list-map Bullet bullets))

  fun gradient-string ramp s =
    let
      val len = string-length s
    in
      layout-concat
      (list-tabulate
       (len,
        (fn i =>
         let
           val t = int-to-float i /. int-to-float len
           val c = codepoint-to-string (string-sub (s, i))
           val rgba = color-linear-gradient (ramp, t)
         in
           color rgba (layout c)
         end)))
    end

  fun conjecture-bullets bull =
    combo-slide (slide with BACKGROUND = "durer.jpg"
                 with CONTENT-START-Y = 540.0
                 with TITLE-FONT-SIZE = 104.0)
    (Title [Albrecht Dürer's Conjecture] ::
     Bullets bull ::
     nil)

  datatype status = Counterexample | Maybe
  val results : (layout * status) list ref = ref nil
  fun scorecard () =
    let
      fun one-entry (name, Counterexample) =
        BulletExt ({(Bullet)
                    bullet = [x],
                    bullet-color = 0xFF0000FF }, name)
        | one-entry (name, Maybe) =
        BulletExt ({(Bullet)
                    bullet = [?],
                    bullet-color = 0x77FF00FF }, name)

      val entries = list-map one-entry (list-rev (!results))
    in
      combo-slide slide
      (Title [Results] :: entries)
    end

in
  set-target-seconds (!current-page, 0);

  title-slide (slide with BACKGROUND = "registration-marks-bg.png")
  [Go to next slide] [ ] [ ];

  set-target-seconds (!current-page, 600);

  (* XXX remove mushrooms here *)
  title-slide slide (color 0xFFFFFFFF [Brechtfast of champions])
  (color 0xc25e32ff [by Tom 7]) (gradient-string VISIBLE-SPECTRUM
                                 "CHRISAMACONF.STL");
  (* "nothing but net" *)

  combo-slide (slide with BACKGROUND = "3dprinting.jpg")
  (Title [.STL = Stereolithography] :: nil);


  combo-slide slide
  (Title [2D Printing] ::
   Bullets ([e.g. [color 0xFF00FFFF [.SVG]] files] ::
            [use this to mail polyhedra to your friends at
             discount flat-pack rates using the postal service] ::
            [100% legal] ::
            nil) ::
   nil);

  combo-slide slide
  (Title [2D Printing] ::
   Image { img = image-load-cache "dodecahedron-example.png",
           x = pixel 100.0,
           y = pixel 100.0,
           scale = ORIGINAL } ::
   nil);

  (* Here's a thing I like about nets. *)
  combo-slide slide
  (Title [Cool] ::
   Image { img = image-load-cache "parens.png",
           x = pixel 100.0,
           y = pixel 100.0,
           scale = ORIGINAL } ::
   nil);

  combo-slide (slide with BACKGROUND = "durer.jpg"
               with CONTENT-START-Y = 540.0
               with TITLE-FONT-SIZE = 104.0)
  (Title [Dead Albrecht Dürer (1471–1582)] ::
   Bullets ([One-trick pony] ::
            [Only cared about convex polyhedra] ::
            [[it (color 0xFFFFCCFF [Call of Duty: Black Ops 6])]
             “Prestige” level: [b (color 0xFF4444FF [Nothing. Zero Points. ] ^^
                                   color 0xFF0000FF [A failure.])]] ::
            nil) ::
   nil);


  attributed-quote-slide (slide with BACKGROUND = "durer.jpg"
                          with QUOTE-FONT-SIZE = 80.0
                          with CONTENT-WIDTH = 900.0)
  [Dürer’s Conjecture]
  [“Every convex polyhedron has a [color 0x99CCFFFF [net]].”]
  [Dead Albrecht Dürer];

  (* compiler bug *)

  monospace-slide (slide
                   with BACKGROUND = "mushroombg.png"
                   with MONOSPACE-FONT-SIZE = 64.0)
  [Compiler büg]
(color 0xAAAAAAFF [[color 0xFFFF99FF [Simplifying...]]
[color 0xEEEECCFF [il-typed-pass.h:527]]:[color 0xFF8888FF [Check failed]]:
tt->type == TypeType::RECORD
Bug? Expected record, but got: a$314
[color 0x777777FF [make: *** [layout "["]makefile:12: chrisamaconf/chrisamaconf.talk[layout "]"] Error 127]]]);

  (* hours later... *)

  (* When I'm feeling stressed out about the state of the world I
     like to find an old very hard math problem and try to solve
     it myself, without looking at any spoilers *)

  conjecture-bullets ([It is very easy to find nets!] :: nil);

  just-image "hard307298.png";

  (* Digging the hole from two sides... *)

  conjecture-bullets ([It is very easy to find nets!] ::
                      [¬¬A] ::
                      nil);

  combo-slide (slide with BACKGROUND = "cereal.png"
               with BODY-FONT-SIZE = 200.0)
  (TextBox { x = 80.0, y = 300.0,
             width = 1920.0 *. 0.5 -. 80.0,
             text = color 0xFFFFFFFF
             [Does \\
              [it [Brechtfast]] \\
              exist?] } ::
   nil);

  just-image "hard251196.png";

  (* The most definitive thing would be to find a counterexample, but
     maybe counterexamples don't exist!
     So I tried strengthening the conjecture... *)

  conjecture-bullets ([It is very easy to find nets!] ::
                      [¬¬A] ::
                      [Maybe it’s so easy that there always
                       exists a net of a special form? Like
                       a line?] ::
                      nil);

  combo-slide (slide
               with BACKGROUND = "mushroombg.png"
               with TITLE-FONT-SIZE = 72.0)
  (Title [Metabidiminished rhombicosidodecahedron] ::
   image-overlay-elt "j81-line.png" ::
   nil);

  just-video slide "line-j81.mkv";

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (image-overlay-elt "have-cube.png" :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (image-overlay-elt "remove-corners.png" :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (image-overlay-elt "cuboctahedron.png" :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (image-overlay-elt "cuboctahedron-parity.png" :: nil);

  combo-slide (slide with BACKGROUND = "mushroombg.png")
  (image-overlay-elt "ohno.png" :: nil);

  results := ([Always a linear net], Counterexample) :: !results;
  scorecard ();

  conjecture-bullets ([It is very easy to find nets!] ::
                      [¬¬A] ::
                      [Maybe it’s so easy that there always
                       exists a net of a special form? Like
                       a line?] ::
                      [Maybe the opposite — like there’s
                       always a “bushy” tree?] ::
                      nil);

  reveal slide
  ((Title [Random spanning trees] :: nil) ::
   (Bullet [Randomly shuffle the edges] :: nil) ::
   (Bullet [For each edge, if it would connect two disconnected
            subgraphs, add it] :: nil) ::
   (Bullet [You can use [color 0xFFFFCCFF [Union–Find]] to incrementally
            test connectedness, which is great because it’s so
            satisfyingly definitive!] :: nil) ::
   (Bullet [Tends toward low “diameter” graphs.] ::
    ImageRHS { img = image-load-cache "bushy-example.png",
               scale = ORIGINAL } ::
    nil) ::
   nil);

  combo-slide slide
  (Title ["Bushy" nets] ::
   Bullet [... define ...] ::
   Bullet [No! You can construct shapes that force
           unfoldings to be "long", regardless of
           whether they are nets] ::
   nil);

  for 1 6
  (fn n =>
   combo-slide (slide with BACKGROUND = "mushroombg.png")
   (image-overlay-elt ("discovery" ^ int-to-string n ^ ".png") :: nil));

  just-video slide "rendered-rubikscube.mkv";

  results := ([Always a (very) bushy net], Counterexample) :: !results;
  scorecard ();

  let
    val proof-slide = slide
      with TITLE-FONT-SIZE = 108.0
      with QUOTE-FONT-SIZE = 90.0

  in

    combo-slide proof-slide
    (Title [What might a proof look like?] ::
     nil);

    attributed-quote-slide (proof-slide
                            with QUOTE-FONT-SIZE = 90.0)
    [What might a proof look like?]
    [“I love going in [color 0xFF00FFFF [Math Holes]].”]
    [Tom 7, Convex Solid Idiot];

    combo-slide proof-slide
    (Title [Constructive Planar Geometry] ::
     image-overlay-elt "construct1.png" ::
     nil);

    combo-slide proof-slide
    (Title [Constructive Planar Geometry] ::
     image-overlay-elt "construct2.png" ::
     nil);

    bullet-reveal proof-slide
    [What might a proof look like?]
    ([EZ: Many options for operations to construct solids.] ::
     [Big problem: Tiny changes to the solid make huge
      changes to the net (via “levers”).] ::
     nil);

    combo-slide proof-slide
    (Title [The lever effect] ::
     image-overlay-elt "lever-effect.png" ::
     nil);

    (* Open problems.. mushrooms *)

    combo-slide proof-slide
    (Title [What might a proof look like?] ::
     Bullet [EZ: Many options for operations to construct solids.] ::
     Bullet [Big problem: Tiny changes to the solid make huge
             changes to the net (via “levers”).] ::
     Bullet [What if we only made changes to the
             [color 0xCCFFFFFF [outer edge]]?] ::
     nil);

    combo-slide (proof-slide with BODY-FONT-FAMILY = font-family CAMBRIA)
    (Title [Strengthened IH] ::
     TextElt [“∀ convex polyhedra [color 0xFF9999FF [p]]. \\
              ∀ oriented edge [color 0xFF55FFFF [e]]. \\
              ∃ a net [color 0x9999FFFF [n]] \\
              such that [color 0xFF55FFFF [e]] is on the
              [color 0x77FFFFFF (it [convex hull])] of
              [color 0x9999FFFF [n]].”] ::
     TextElt [—Tom 7] ::
     ImageRHS { img = image-load-cache "convex-hull.png",
                scale = ORIGINAL } ::
     nil);

    combo-slide proof-slide
    (Title [This is [color 0xFF4444FF [false]]!] ::
     ImageRHS { img = image-load-cache "convex-hull-false.png",
                scale = ORIGINAL } ::
     nil);

    ()
  end;

  results := ([Can put edge on convex hull], Counterexample) :: !results;
  scorecard ();


  combo-slide (slide with BODY-FONT-FAMILY = font-family CAMBRIA
               with BODY-FONT-SIZE = 86.0)
  (Title [Weakened Strengthened IH] ::
   TextElt [“∀ convex polyhedra [color 0xFF9999FF [p]]. \\
            ∀ face [color 0xFFFF77FF [f]]. \\
            ∀ edge [color 0xFF55FFFF [e]] on [color 0xFFFF77FF [f]]. \\
            ∃ a net [color 0x9999FFFF [n]] \\
            such that [color 0xFFFF77FF [f]] is a
            [color 0x55FF55FF (it [leaf])] \\
            connected only by [color 0xFF55FFFF [e]].”] ::
   TextElt [—Tom 7] ::
   ImageRHS { img = image-load-cache "j10-leaf.png",
              scale = ORIGINAL } ::
   nil);

  combo-slide slide
  (image-overlay-elt "cigar-leaves.png" :: nil);

  results := ([Can get chosen face/edge as a leaf], Maybe) :: !results;
  scorecard ();


  reveal slide
  ((Title [This is where I need your help] :: nil) ::
   (TextElt [What does any of this have to do with mushrooms?] :: nil) ::
   nil);

  combo-slide (slide with BACKGROUND = "color-mushroombg.png")
  nil;

  ()

end
